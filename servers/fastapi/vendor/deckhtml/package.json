{
  "name": "@deckflow/deckhtml",
  "version": "0.6.2",
  "description": "Convert HTML to PPTX or PNG presentations (vendored in Sunairum with local fidelity patches)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "schemas"
  ],
  "bin": {
    "deckhtml": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test:layout-faithful": "npm run build && node scripts/test-layout-faithful.mjs",
    "test:layout-faithful-corpus": "npm run build && node scripts/test-layout-faithful-corpus.mjs",
    "test:closed-loop-fidelity": "npm run build && node scripts/test-closed-loop-fidelity.mjs",
    "test:image-roundrect-targeting": "npm run build && node scripts/test-image-roundrect-targeting.mjs",
    "test:gradient-coverage": "npm run build && node scripts/test-gradient-coverage.mjs",
    "test:frozen-text": "npm run build && node scripts/test-frozen-text.mjs",
    "test:bullet-row-inset": "npm run build && node scripts/test-bullet-row-inset.mjs",
    "test:no-export-overlap": "npm run build && node scripts/test-no-export-overlap.mjs",
    "convert:samples": "npm run build && node scripts/convert-sample-inputs.mjs",
    "build:font-index": "npx tsx src/bin/build-embed-font-index.ts",
    "build:fa-eot": "node scripts/build-fa-eot.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist/",
    "link:dev": "npm run build && npm link",
    "unlink:dev": "npm unlink -g @deckflow/deckhtml",
    "global:install": "npm run build && npm install -g .",
    "global:uninstall": "npm uninstall -g @deckflow/deckhtml",
    "pack:global": "npm run build && npm pack && npm install -g ./deckflow-deckhtml-*.tgz",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "html",
    "pptx",
    "powerpoint",
    "converter",
    "deckhtml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckflow/deckhtml.git"
  },
  "bugs": {
    "url": "https://github.com/deckflow/deckhtml/issues"
  },
  "homepage": "https://github.com/deckflow/deckhtml#readme",
  "license": "MIT",
  "dependencies": {
    "@deckops/sdk": "^0.7.3",
    "chrome-launcher": "^1.2.1",
    "commander": "^11.1.0",
    "jszip": "^3.10.1",
    "mathml2omml": "^0.5.0",
    "open": "^11.0.0",
    "playwright-core": "^1.62.0",
    "pptxgenjs": "4.0.1",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.3"
  }
}
