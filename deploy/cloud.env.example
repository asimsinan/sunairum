# Copy this file to deploy/cloud.env and replace every placeholder.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sunairumdb

# Public hostname. Set it to a domain whose DNS points at this host and Caddy
# provisions a Let's Encrypt certificate on the first request. Leave it empty to
# serve plain HTTP on the raw IP. No owned domain? Use sslip.io, e.g. for
# 170.9.238.9 → DOMAIN=170-9-238-9.sslip.io then open https://170-9-238-9.sslip.io
DOMAIN=

# Prebuilt images to pull, produced by ./deploy/build-push.sh. Building on the
# deployment host instead costs ~900MB of torch plus 731MB of baked Docling
# weights, competing with the RAM the running stack needs.
IMAGE_PREFIX=ghcr.io/your-org/sunairum
IMAGE_TAG=latest

# FastAPI environment file. Keep provider keys outside the image and repository.
FASTAPI_ENV_FILE=./deploy/fastapi.env

# Optional deployment tuning.
HTTP_PORT=80
HTTPS_PORT=443
# Only needed when the API runs on a different host than the frontend. Empty
# means the browser calls the same origin through the proxy, which is why one
# published web image works for any domain.
NEXT_PUBLIC_API_URL=
DOCLING_DEVICE=cpu
SOURCE_PARSER=docling
SOURCE_PARSER_TIMEOUT_SECONDS=900
# Generation worker concurrency (`celery_generation` / `generation` queue).
CELERY_CONCURRENCY=2
# Source-import worker concurrency (`celery_source_import` / `source_import`).
# A single Docling parse peaks near 2.3GB — keep at 1 unless the host has headroom.
CELERY_SOURCE_IMPORT_CONCURRENCY=1
# Parsing uses only the models baked into the worker image at /opt/docling-models.
# Leave at 1 so a missing weight fails fast instead of stalling on a download.
HF_HUB_OFFLINE=1
# LaTeX extraction from formulas. Roughly 26x slower parses, and the model is not
# baked unless the image was built with --build-arg WITH_FORMULA_MODEL=1.
DOCLING_FORMULA_ENRICHMENT=0
# torch.compile the layout model. Costs ~9s once per worker process and then
# parses a page in ~1.9s against ~2.2s uncompiled, so a long-lived worker wins.
# Set to 0 if fast cold starts matter more than steady-state throughput.
DOCLING_COMPILE_MODELS=1
