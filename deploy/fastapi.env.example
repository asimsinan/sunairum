# Copy to deploy/fastapi.env.
# LLM / vision / image credentials and models are configured in the Settings UI.
# Do not set GEMINI_* — Google Gemini is not supported.
# Optional non-secret OpenRouter app headers for requests that go through OpenRouter:
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=Sunairum

# Auth / sessions (Redis-backed). Defaults seed admin/admin when no admin exists.
# ADMIN_EMAIL=admin
# ADMIN_PASSWORD=admin
# Local/dev only — leaves sample users in the admin panel. Keep off in production.
# SEED_DEMO_USERS=0
# Public self-serve signup. On by default; set to 0 to close registration.
SIGNUP_ENABLED=1
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_COOKIE_SECURE=1
SETTINGS_SECRET_KEY=replace-with-long-random-string
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
CORS_ALLOW_ORIGINS=https://170-9-238-9.sslip.io,http://localhost:3000

# Celery topology (set in deploy/cloud.env for Compose; optional here for docs).
# CELERY_CONCURRENCY controls the generation worker (legacy name).
# CELERY_SOURCE_IMPORT_CONCURRENCY controls the Docling/import worker (default 1).
# CELERY_CONCURRENCY=2
# CELERY_SOURCE_IMPORT_CONCURRENCY=1
