# Oracle Cloud defaults. Copy to deploy/cloud.env on the instance
# (deploy/oracle/setup.sh does this via deploy/install.sh + overrides).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sunairumdb

# Empty = plain HTTP on the public IP. Set a DNS name for HTTPS via Caddy.
# No owned domain: sslip.io — e.g. DOMAIN=170-9-238-9.sslip.io
DOMAIN=

# Prebuilt images (must match instance arch):
#   Ampere A1 (aarch64): build with PLATFORM=linux/arm64 ./deploy/build-push.sh
#   AMD x86 trial VM:    default PLATFORM=linux/amd64
# Leave a placeholder / your-org value to force ./deploy/up.sh --build on the VM.
IMAGE_PREFIX=ghcr.io/your-org/sunairum
IMAGE_TAG=latest

FASTAPI_ENV_FILE=./deploy/fastapi.env
HTTP_PORT=80
HTTPS_PORT=443
NEXT_PUBLIC_API_URL=

DOCLING_DEVICE=cpu
SOURCE_PARSER=docling
SOURCE_PARSER_TIMEOUT_SECONDS=900
# Always Free Ampere (2 OCPU / 12 GB): keep generation at 1 for beta.
CELERY_CONCURRENCY=1
# Docling peaks ~2.3GB — leave import at 1 on 12 GB hosts.
CELERY_SOURCE_IMPORT_CONCURRENCY=1
HF_HUB_OFFLINE=1
DOCLING_FORMULA_ENRICHMENT=0
DOCLING_COMPILE_MODELS=1
